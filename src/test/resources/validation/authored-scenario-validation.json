          "message": "История просмотрена. Теперь можно открыть более наглядный граф перед cleanup."
        },
        {
          "rawCommand": "git log --oneline --graph --decorate",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Компактный граф истории показал fixup и WIP-сигналы без переписывания коммитов."
        },
        {
          "rawCommand": "git log --graph --oneline --decorate",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Компактный граф истории показал fixup и WIP-сигналы без переписывания коммитов."
        }
      ]
    },
    {
      "scenarioSlug": "remote-sync-preview",
      "validatorType": "git_repo_state_probe",
      "config": {
        "expectedExitCode": 0,
        "workspaceTemplate": {
          "initialBranch": "main",
          "remoteName": "origin",
          "localAheadCommitMessage": "local notes WIP",
          "remoteAheadCommitMessage": "remote hotfix ready",
          "baseFiles": [
            { "path": "README.md", "content": "# Git Trainer\n" },
            { "path": "docs/sync-playbook.md", "content": "- inspect divergence\n" }
          ],
          "localAheadFiles": [
            { "path": "docs/local-notes.md", "content": "- pending local integration\n" }
          ],
          "remoteAheadFiles": [
            { "path": "release/remote-hotfix.md", "content": "- hotfix available upstream\n" }
          ]
        },
        "expectedState": {
          "currentBranch": "main",
          "localHeadCommitMessage": "local notes WIP",
          "fetchHeadCommitMessage": "remote hotfix ready",
          "remoteTrackingRefs": [
            { "ref": "refs/remotes/origin/main", "commitMessage": "remote hotfix ready" }
          ]
        }
      },
      "rules": [
        {
          "rawCommand": "git fetch",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Удалённое состояние обновлено отдельно от интеграции."
        },
        {
          "rawCommand": "git fetch origin",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Удалённое состояние обновлено отдельно от интеграции."
        },
        {
          "rawCommand": "git fetch --all --prune",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Удалённое состояние обновлено отдельно от интеграции."
        }
      ]
    },
    {
      "scenarioSlug": "stash-checkpoint-draft",
      "validatorType": "git_command_probe",
      "config": {
        "expectedExitCode": 0,
        "expectedWorkspaceState": {
          "currentBranch": "feature/test-stash-panel",
          "workingTreeClean": true,
          "stashEntryCount": 1
        },
        "workspaceTemplate": {
          "initialBranch": "main",
          "currentBranch": "feature/test-stash-panel",
          "branches": ["feature/test-stash-panel", "main"],
          "committedFiles": [
            { "path": "frontend/src/demo-panel.js", "content": "export const panel = 'draft';\n" }
          ],
          "modifiedFiles": [
            { "path": "frontend/src/demo-panel.js", "content": "export const panel = 'draft-staged';\n" }
          ],
          "untrackedFiles": [
            { "path": "notes/ui-placeholder.txt", "content": "temporary ui notes\n" }
          ]
        }
      },
      "rules": [
        {
          "rawCommand": "git status -sb",
          "correctness": "partial",
          "code": "workspace-inspected",
          "message": "Контекст подтверждён, теперь сохраните текущие изменения в stash."
        },
        {
          "rawCommand": "git status --short",
          "correctness": "partial",
          "code": "workspace-inspected",
          "message": "Контекст подтверждён, теперь сохраните текущие изменения в stash."
        },
        {
          "rawCommand": "git stash push -u",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Изменения и untracked-файлы безопасно убраны в stash."
        },
        {
          "rawCommand": "git stash push --include-untracked",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Изменения и untracked-файлы безопасно убраны в stash."
        },
        {
          "rawCommand": "git stash push -u -m \"ui-test\"",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Изменения и untracked-файлы безопасно убраны в stash."
        }
      ]
    },
    {
      "scenarioSlug": "merge-sandbox-outline",
      "validatorType": "git_command_probe",
      "config": {
        "expectedExitCode": 0,
