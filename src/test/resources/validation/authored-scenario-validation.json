          "currentBranch": "feature/mock-merge-window",
          "branches": ["feature/mock-merge-window", "release/demo", "main"],
          "committedFiles": [
            { "path": "frontend/src/merge-banner.js", "content": "export const mergeBanner = 'draft';\n" },
            { "path": "docs/mock-merge-plan.md", "content": "- inspect merge shape\n" }
          ],
          "modifiedFiles": [
            { "path": "frontend/src/merge-banner.js", "content": "export const mergeBanner = 'outline';\n" },
            { "path": "docs/mock-merge-plan.md", "content": "- inspect merge shape\n- review diff\n" }
          ],
          "untrackedFiles": []
        }
      },
      "rules": [
        {
          "rawCommand": "git status -sb",
          "correctness": "partial",
          "code": "merge-context-confirmed",
          "message": "Контекст ветки просмотрен. Теперь можно безопасно открыть diff или граф."
        },
        {
          "rawCommand": "git diff main...feature/mock-merge-window",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Preview различий собран без запуска merge."
        },
        {
          "rawCommand": "git log --oneline --graph --decorate --all",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Граф веток просмотрен без запуска merge."
        }
      ]
    },
