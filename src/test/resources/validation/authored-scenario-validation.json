            { "path": "frontend/src/workspace-shell/view.js", "content": "export const badge = 'shell';\n" }
          ],
          "modifiedFiles": [
            { "path": "frontend/src/styles.css", "content": ".badge { padding: 6px; }\n" },
            { "path": "frontend/src/workspace-shell/view.js", "content": "export const badge = 'shell-preview';\n" }
          ],
          "untrackedFiles": []
        }
      },
      "rules": [
        {
          "rawCommand": "git log --oneline --decorate",
