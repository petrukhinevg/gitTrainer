{
  "definitions": [
    {
      "scenarioSlug": "status-basics",
      "validatorType": "git_command_probe",
      "config": {
        "expectedExitCode": 0,
        "expectedWorkspaceState": {
          "currentBranch": "main",
          "workingTreeClean": false
        },
        "workspaceTemplate": {
          "initialBranch": "main",
          "currentBranch": "main",
          "branches": ["docs/review-notes"],
          "committedFiles": [
            { "path": "README.md", "content": "# Git Trainer\n" },
            { "path": "src/main.js", "content": "export const workspaceShell = 'stable';\n" }
          ],
          "modifiedFiles": [
            { "path": "README.md", "content": "# Git Trainer\n\n- review draft\n" },
            { "path": "src/main.js", "content": "export const workspaceShell = 'noisy';\n" }
          ],
          "untrackedFiles": [
            { "path": "notes/status-checklist.md", "content": "- inspect modified files\n" }
          ]
        }
      },
      "rules": [
        {
          "rawCommand": "git status",
          "correctness": "partial",
          "code": "working-tree-inspected",
          "message": "Рабочее дерево просмотрено. Теперь можно выбрать более компактный статус."
        },
        {
          "rawCommand": "git status --short",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Краткий статус корректно показывает tracked и untracked изменения."
        },
        {
          "rawCommand": "git status -sb",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Краткий статус корректно показывает tracked и untracked изменения."
        }
      ]
    },
    {
      "scenarioSlug": "branch-safety",
      "validatorType": "git_command_probe",
      "config": {
        "expectedExitCode": 0,
        "expectedWorkspaceState": {
          "currentBranch": "release/hotfix-7",
          "workingTreeClean": false
        },
        "requiredPriorCommandsByCommand": {
          "git status -sb": ["git branch --show-current"],
          "git status --short -b": ["git branch --show-current"]
        },
        "workspaceTemplate": {
          "initialBranch": "main",
          "currentBranch": "release/hotfix-7",
          "branches": ["release/hotfix-7", "feature/menu-refresh", "main"],
          "committedFiles": [
            { "path": "src/ui/header.css", "content": ".header { padding: 8px; }\n" },
            { "path": "docs/release-checklist.md", "content": "- verify deploy\n" }
          ],
          "modifiedFiles": [
            { "path": "src/ui/header.css", "content": ".header { padding: 12px; }\n" },
            { "path": "docs/release-checklist.md", "content": "- verify deploy\n- smoke test\n" }
          ],
          "untrackedFiles": []
        }
      },
      "rules": [
        {
          "rawCommand": "git branch --show-current",
          "correctness": "partial",
          "code": "branch-context-confirmed",
          "message": "Активная ветка подтверждена. Теперь соберите компактный статус незавершённых правок."
        },
        {
          "rawCommand": "git status -sb",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Активная ветка и незавершённые правки подтверждены безопасными командами чтения."
        },
        {
          "rawCommand": "git status --short -b",
          "correctness": "correct",
          "code": "expected-command",
          "message": "Активная ветка и незавершённые правки подтверждены безопасными командами чтения."
        }
      ]
    },
    {
      "scenarioSlug": "history-cleanup-preview",
